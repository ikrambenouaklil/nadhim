    android:shape="rectangle">
    <corners android:radius="14dp" />
    <gradient
        android:type="radial"
        android:gradientRadius="40dp"
        android:startColor="#AB00F1"
        android:centerColor="#CB5FF7"
        android:endColor="#EBBDFE" />
</shape>
