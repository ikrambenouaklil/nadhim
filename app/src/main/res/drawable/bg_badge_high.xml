<?xml version="1.0" encoding="utf-8"?>
<!-- Purple gradient for HIGH priority, matching the Figma priority cards. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="18dp" />
    <gradient
        android:type="linear"
        android:angle="0"
        android:startColor="@color/priority_high_start"
        android:endColor="@color/priority_high_end" />
</shape>
