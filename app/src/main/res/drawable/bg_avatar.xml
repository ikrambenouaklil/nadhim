<?xml version="1.0" encoding="utf-8"?>
<!-- Dark navy profile circle with a restrained Figma-blue edge and soft center glow. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:type="radial"
        android:gradientRadius="48dp"
        android:startColor="#123C87"
        android:centerColor="#0A255D"
        android:endColor="#061638" />
    <stroke android:width="1dp" android:color="@color/brand_blue_mid" />
</shape>
