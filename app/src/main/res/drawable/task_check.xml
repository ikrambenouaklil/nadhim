<?xml version="1.0" encoding="utf-8"?>
<!-- A "selector" picks a drawable depending on the view's state.
     The task CheckBox uses it: ticked → blue circle, otherwise → empty circle. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true" android:drawable="@drawable/check_checked" />
    <item android:drawable="@drawable/check_unchecked" />
</selector>
