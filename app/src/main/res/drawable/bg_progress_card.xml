<?xml version="1.0" encoding="utf-8"?>
<!-- Background of the blue "Daily progress" card:
     18dp rounded corners + radial gradient from deep blue (center) to light blue (edges). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="18dp" />
    <gradient
        android:type="radial"
        android:gradientRadius="190dp"
        android:startColor="@color/brand_blue"
        android:centerColor="@color/brand_blue_mid"
        android:endColor="@color/brand_blue_light" />
</shape>
