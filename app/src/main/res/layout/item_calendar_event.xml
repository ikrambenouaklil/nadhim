<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <CheckBox
        android:id="@+id/calendarEventCheck"
        android:layout_width="34dp"
        android:layout_height="42dp"
        android:background="@android:color/transparent"
        android:button="@drawable/task_check"
        android:contentDescription="Mark task complete"
        android:minWidth="34dp"
        android:minHeight="42dp"
        android:padding="0dp" />

    <TextView
        android:id="@+id/calendarEventTime"
        android:layout_width="49dp"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:paddingTop="12dp"
        android:paddingEnd="7dp"
        android:textColor="@color/insight_muted"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/bg_calendar_event_card"
        android:gravity="center_vertical"
        android:minHeight="62dp"
        android:orientation="horizontal"
        android:paddingStart="9dp"
        android:paddingTop="8dp"
        android:paddingEnd="6dp"
        android:paddingBottom="8dp">

        <View
            android:id="@+id/calendarEventPriorityBar"
            android:layout_width="4dp"
            android:layout_height="46dp"
            android:layout_marginEnd="9dp"
            android:background="@color/brand_blue" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/calendarEventTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/card_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/calendarEventDetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/card_text_secondary"
                android:textSize="10sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/calendarEventEdit"
            android:layout_width="36dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="Edit task"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_edit" />
        <ImageButton
            android:id="@+id/calendarEventDelete"
            android:layout_width="36dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="Delete task"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_delete" />
    </LinearLayout>
</LinearLayout>
