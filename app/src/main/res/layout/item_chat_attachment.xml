<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chatAttachmentCard" android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:gravity="center_vertical" android:orientation="horizontal"
    android:paddingStart="10dp" android:paddingTop="8dp" android:paddingEnd="12dp" android:paddingBottom="8dp"
    android:background="@drawable/bg_chat_attachment">
    <ImageView android:id="@+id/chatAttachmentImage" android:layout_width="54dp" android:layout_height="54dp"
        android:scaleType="centerCrop" android:visibility="gone" />
    <TextView android:id="@+id/chatAttachmentIcon" android:layout_width="42dp" android:layout_height="42dp"
        android:gravity="center" android:text="▤" android:textSize="22sp" android:textColor="@color/brand_blue" />
    <TextView android:id="@+id/chatAttachmentName" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="9dp" android:maxWidth="190dp" android:maxLines="2"
        android:ellipsize="end" android:textSize="13sp" android:textColor="@color/chat_text_primary" android:textStyle="bold" />
    <TextView android:id="@+id/chatAttachmentRemove" android:layout_width="28dp" android:layout_height="42dp"
        android:layout_marginStart="6dp" android:gravity="center" android:text="×" android:textSize="22sp"
        android:textColor="@color/chat_text_secondary" android:visibility="gone" />
</LinearLayout>
