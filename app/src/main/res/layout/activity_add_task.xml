<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">



            <!-- Titre -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Add a new task"
                android:textColor="#172033"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Tell Nadhim what you need to get done"
                android:textColor="#64748B"
                android:textSize="13sp" />

            <!-- Task description -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Task description"
                android:textColor="#172033"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/descriptionInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card"
                android:gravity="top|start"
                android:hint="e.g. Prepare the marketing presentation for Friday..."
                android:inputType="textMultiLine|textCapSentences"
                android:minHeight="120dp"
                android:padding="14dp"
                android:textColor="#334155"
                android:textColorHint="#94A3B8"
                android:textSize="13sp" />

            <!-- Deadline -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Deadline"
                android:textColor="#172033"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/deadlineField"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <TextView
                    android:id="@+id/deadlineText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▦   Select date and time"
                    android:textColor="#94A3B8"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Additional details -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Additional details"
                android:textColor="#172033"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/detailsInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card"
                android:gravity="top|start"
                android:hint="Add notes or context (optional)"
                android:inputType="textMultiLine|textCapSentences"
                android:minHeight="80dp"
                android:padding="14dp"
                android:textColor="#334155"
                android:textColorHint="#94A3B8"
                android:textSize="13sp" />

            <!-- Estimated duration -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Estimated duration"
                android:textColor="#172033"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chip30"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="30 min"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chip60"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="1 hour"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chip120"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="2 hours"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Bouton principal -->
            <TextView
                android:id="@+id/analyzeButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="26dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="✦  Analyze with Nadhim"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>