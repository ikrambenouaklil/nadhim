<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#660B1220"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/chatPanel"
        android:layout_width="match_parent"
        android:layout_height="500dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_chat_panel"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="16dp"
        android:paddingEnd="18dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Chat with Nadhim"
                android:textColor="#172033"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/closeChatButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="Close chat"
                android:gravity="center"
                android:text="×"
                android:textColor="#64748B"
                android:textSize="28sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:paddingBottom="12dp"
            android:text="Tell me what you need to do, and I’ll help you organize it. AI chat will be connected later."
            android:textColor="#64748B"
            android:textSize="13sp" />

        <ScrollView
            android:id="@+id/chatScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/chatMessages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:layout_marginBottom="9dp"
                    android:background="@drawable/bg_chat_received"
                    android:paddingStart="13dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="13dp"
                    android:paddingBottom="10dp"
                    android:text="Hi! What would you like to plan today?"
                    android:textColor="#334155"
                    android:textSize="14sp" />
            </LinearLayout>
        </ScrollView>

        <HorizontalScrollView
            android:id="@+id/pendingAttachmentsScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/pendingAttachmentsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="2dp" />
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_chat_composer"
            android:gravity="center_vertical"
            android:paddingStart="6dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/attachButton"
                android:layout_width="38dp"
                android:layout_height="44dp"
                android:contentDescription="Attach an image or file"
                android:gravity="center"
                android:text="＋"
                android:textColor="#2563EB"
                android:textSize="24sp" />

            <EditText
                android:id="@+id/chatInput"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Write a message…"
                android:singleLine="true"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/sendChatButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_chat_send"
                android:contentDescription="Send message"
                android:gravity="center"
                android:text="➤"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
