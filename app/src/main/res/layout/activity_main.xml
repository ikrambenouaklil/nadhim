<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
>



    <!-- ===== 2. SCROLLABLE CONTENT ===== -->
    <!-- layout_marginBottom="69dp" (bar height 56 + gap 13) makes the scrolling
         area stop just above the bottom bar, so nothing slides underneath it.
         paddingBottom adds a little space after the last card. -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <!-- ===== GREETING ===== -->
            <!-- The text is set from MainActivity.java (it depends on the time of day). -->
            <TextView
                android:id="@+id/greeting"
                style="@style/Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="19dp"
                android:fontFamily="@font/poppins_bold"
                android:textSize="24sp" />

            <!-- Today's date. Also filled in from Java. -->
            <TextView
                android:id="@+id/date"
                style="@style/Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <!-- ===== DAILY PROGRESS CARD (blue) ===== -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="112dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_progress_card"
                android:paddingStart="16dp"
                android:paddingTop="16dp"
                android:paddingEnd="19dp">

                <TextView
                    android:id="@+id/progress_title"
                    style="@style/Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="@string/daily_progress"
                    android:textColor="@color/white"
                    android:textSize="13sp" />

                <!-- "3 of 5 tasks completed": filled in from Java. -->
                <TextView
                    android:id="@+id/progress_subtitle"
                    style="@style/Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/progress_title"
                    android:layout_marginTop="5dp"
                    android:textColor="@color/white"
                    android:textSize="10sp" />

                <!-- "60%" in green on the right: filled in from Java. -->
                <TextView
                    android:id="@+id/progress_percent"
                    style="@style/Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_marginTop="25dp"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="@color/accent_green"
                    android:textSize="12sp" />

                <!-- Built-in horizontal ProgressBar, drawn with our own colors
                     (see drawable/progress_bar.xml). max=100 means the progress
                     value is a percentage. -->
                <ProgressBar
                    android:id="@+id/progress_bar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="55dp"
                    android:max="100"
                    android:progressDrawable="@drawable/progress_bar" />
            </RelativeLayout>

            <!-- ===== YOUR PRIORITIES ===== -->
            <TextView
                style="@style/Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="4dp"
                android:fontFamily="@font/poppins_bold"
                android:text="@string/your_priorities"
                android:textSize="17sp" />

            <!-- Each task card is a horizontal row:
                 [ tick circle ] [ title + time (takes the free space) ] [ badge ]
                 The look of the card, tick box and badge comes from the styles in
                 values/styles.xml, so the three cards stay identical. -->

            <!-- Task 1 · HIGH -->
            <LinearLayout style="@style/TaskCard">

                <CheckBox
                    android:id="@+id/task1_check"
                    style="@style/TaskCheck"
                    android:contentDescription="@string/task1_title" />

                <!-- layout_width="0dp" + layout_weight="1" = "fill the space that is left". -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/task1_title"
                        style="@style/Text.TaskTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/task1_title" />

                    <TextView
                        style="@style/Text.TaskTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/task1_time" />
                </LinearLayout>

                <TextView
                    style="@style/Text.Badge"
                    android:background="@drawable/bg_badge_high"
                    android:text="@string/priority_high" />
            </LinearLayout>

            <!-- Task 2 · MED -->
            <LinearLayout style="@style/TaskCard">

                <CheckBox
                    android:id="@+id/task2_check"
                    style="@style/TaskCheck"
                    android:contentDescription="@string/task2_title" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/task2_title"
                        style="@style/Text.TaskTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/task2_title" />

                    <TextView
                        style="@style/Text.TaskTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/task2_time" />
                </LinearLayout>

                <TextView
                    style="@style/Text.Badge"
                    android:background="@drawable/bg_badge_med"
                    android:text="@string/priority_med" />
            </LinearLayout>

            <!-- Task 3 · LOW (dark text on the green badge, as in Figma) -->
            <LinearLayout style="@style/TaskCard">

                <CheckBox
                    android:id="@+id/task3_check"
                    style="@style/TaskCheck"
                    android:contentDescription="@string/task3_title" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/task3_title"
                        style="@style/Text.TaskTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/task3_title" />

                    <TextView
                        style="@style/Text.TaskTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/task3_time" />
                </LinearLayout>

                <TextView
                    style="@style/Text.Badge"
                    android:background="@drawable/bg_badge_low"
                    android:text="@string/priority_low"
                    android:textColor="@color/text_primary" />
            </LinearLayout>

            <!-- ===== NADHIM SUGGESTS CARD ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="112dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_suggestion"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="15dp"
                android:paddingEnd="16dp">

                <TextView
                    style="@style/Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:text="@string/suggestion_label"
                    android:textColor="@color/brand_blue"
                    android:textSize="9sp" />

                <TextView
                    style="@style/Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="@string/suggestion_title"
                    android:textSize="13sp" />

                <TextView
                    style="@style/Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/suggestion_body"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

  
</FrameLayout>
