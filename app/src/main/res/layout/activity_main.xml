<?xml version="1.0" encoding="utf-8"?>
<!--
    SCREEN 01 · "Today" (light theme), built from the Figma frame "01 Today · Light".

    How the screen is stacked (a FrameLayout draws its children on top of each other):
      1. two faint decorative images (grid lines + blue glow) as the background
      2. a ScrollView with all the content, so it can scroll on small phones
      3. the bottom navigation bar, which stays fixed at the bottom

    Units: "dp" is used for sizes and "sp" for text sizes. They scale with the phone's
    screen density (and, for sp, with the user's font-size setting). The Figma frame is
    390 wide, so 1 Figma pixel ≈ 1dp.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background">

    <!-- ===== 1. DECORATIVE BACKGROUND ===== -->
    <!-- Very faint grid lines covering the whole screen (Figma layer "grid").
         importantForAccessibility="no" tells screen readers to skip it. -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/bg_grid" />

    <!-- Soft blue glow at the top right (Figma layer "Star 1"). -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/bg_glow" />

    <!-- ===== 2. SCROLLABLE CONTENT ===== -->
    <!-- layout_marginBottom="69dp" (bar height 56 + gap 13) makes the scrolling
         area stop just above the bottom bar, so nothing slides underneath it.
         paddingBottom adds a little space after the last card. -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="69dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        android:scrollbars="none">

        <!-- A vertical LinearLayout places its children one under the other.
             20dp on each side = the margins used in the Figma design. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp">

            <!-- ===== HEADER: logo, tagline and profile circle ===== -->
            <!-- RelativeLayout positions children relative to each other
                 (for example "below the logo" or "on the right edge"). -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- "Nadhim" logo (vector image converted from Figma). -->
                <ImageView
                    android:id="@+id/logo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="1dp"
                    android:contentDescription="@string/logo_description"
                    android:src="@drawable/logo_nadhim" />

                <!-- Small grey tagline under the logo. -->
                <TextView
                    style="@style/Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/logo"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="@string/tagline"
                    android:textColor="@color/text_secondary"
                    android:textSize="8sp" />

                <!-- Profile circle with the user's initial, pinned to the right. -->
                <TextView
                    android:id="@+id/avatar"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_alignParentEnd="true"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_avatar"
                    android:contentDescription="@string/profile_description"
                    android:fontFamily="@font/poppins_bold"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text=""
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </RelativeLayout>

            <!-- Thin horizontal line under the header. A plain View with a
                 background color and 1dp height is the simplest divider. -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="9dp"
                android:background="@color/border" />

            <!-- ===== GREETING ===== -->
            <!-- The text is set from MainActivity.java (it depends on the time of day). -->
            <TextView
                android:id="@+id/greeting"
                style="@style/Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="19dp"
                android:fontFamily="@font/poppins_bold"
                android:textSize="24sp" />

            <!-- Today's date. Also filled in from Java. -->
            <TextView
                android:id="@+id/date"
                style="@style/Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <!-- ===== DAILY PROGRESS CARD (blue) ===== -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="112dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_progress_card"
                android:paddingStart="16dp"
                android:paddingTop="16dp"
                android:paddingEnd="19dp">

                <TextView
                    android:id="@+id/progress_title"
                    style="@style/Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="@string/daily_progress"
                    android:textColor="@color/white"
                    android:textSize="13sp" />

                <!-- "3 of 5 tasks completed": filled in from Java. -->
                <TextView
                    android:id="@+id/progress_subtitle"
                    style="@style/Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/progress_title"
                    android:layout_marginTop="5dp"
                    android:textColor="@color/white"
                    android:textSize="10sp" />

                <!-- "60%" in green on the right: filled in from Java. -->
                <TextView
                    android:id="@+id/progress_percent"
                    style="@style/Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_marginTop="25dp"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="@color/accent_green"
                    android:textSize="12sp" />

                <!-- Built-in horizontal ProgressBar, drawn with our own colors
                     (see drawable/progress_bar.xml). max=100 means the progress
                     value is a percentage. -->
                <ProgressBar
                    android:id="@+id/progress_bar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="55dp"
                    android:max="100"
                    android:progressDrawable="@drawable/progress_bar" />
            </RelativeLayout>

            <!-- ===== YOUR PRIORITIES ===== -->
            <TextView
                style="@style/Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="4dp"
                android:fontFamily="@font/poppins_bold"
                android:text="@string/your_priorities"
                android:textSize="17sp" />

            <!-- Each task card is a horizontal row:
                 [ tick circle ] [ title + time (takes the free space) ] [ badge ]
                 The look of the card, tick box and badge comes from the styles in
                 values/styles.xml, so the three cards stay identical. -->

            <!-- Task 1 · HIGH -->
            <LinearLayout style="@style/TaskCard">

                <CheckBox
                    android:id="@+id/task1_check"
                    style="@style/TaskCheck"
                    android:contentDescription="@string/task1_title" />

                <!-- layout_width="0dp" + layout_weight="1" = "fill the space that is left". -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/task1_title"
                        style="@style/Text.TaskTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/task1_title" />

                    <TextView
                        style="@style/Text.TaskTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/task1_time" />
                </LinearLayout>

                <TextView
                    style="@style/Text.Badge"
                    android:background="@drawable/bg_badge_high"
                    android:text="@string/priority_high" />
            </LinearLayout>

            <!-- Task 2 · MED -->
            <LinearLayout style="@style/TaskCard">

                <CheckBox
                    android:id="@+id/task2_check"
                    style="@style/TaskCheck"
                    android:contentDescription="@string/task2_title" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/task2_title"
                        style="@style/Text.TaskTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/task2_title" />

                    <TextView
                        style="@style/Text.TaskTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/task2_time" />
                </LinearLayout>

                <TextView
                    style="@style/Text.Badge"
                    android:background="@drawable/bg_badge_med"
                    android:text="@string/priority_med" />
            </LinearLayout>

            <!-- Task 3 · LOW (dark text on the green badge, as in Figma) -->
            <LinearLayout style="@style/TaskCard">

                <CheckBox
                    android:id="@+id/task3_check"
                    style="@style/TaskCheck"
                    android:contentDescription="@string/task3_title" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/task3_title"
                        style="@style/Text.TaskTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/task3_title" />

                    <TextView
                        style="@style/Text.TaskTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/task3_time" />
                </LinearLayout>

                <TextView
                    style="@style/Text.Badge"
                    android:background="@drawable/bg_badge_low"
                    android:text="@string/priority_low"
                    android:textColor="@color/text_primary" />
            </LinearLayout>

            <!-- ===== NADHIM SUGGESTS CARD ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="112dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_suggestion"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="15dp"
                android:paddingEnd="16dp">

                <TextView
                    style="@style/Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:text="@string/suggestion_label"
                    android:textColor="@color/brand_blue"
                    android:textSize="9sp" />

                <TextView
                    style="@style/Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="@string/suggestion_title"
                    android:textSize="13sp" />

                <TextView
                    style="@style/Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/suggestion_body"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- ===== 3. BOTTOM NAVIGATION BAR ===== -->
    <!-- layout_gravity="bottom" sticks it to the bottom of the FrameLayout,
         so it stays in place while the content above scrolls.
         The four tabs share the width equally (layout_weight="1" in the NavItem style). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="13dp"
        android:background="@drawable/bg_bottom_nav"
        android:orientation="horizontal"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <!-- "Today": the tab we're on, so it gets the light blue pill and blue text. -->
        <LinearLayout
            android:id="@+id/nav_today"
            style="@style/NavItem"
            android:background="@drawable/bg_nav_active"
            android:contentDescription="@string/nav_today">

            <TextView
                style="@style/Text.NavIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_today_icon"
                android:textColor="@color/brand_blue" />

            <TextView
                style="@style/Text.NavLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_today"
                android:textColor="@color/brand_blue" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_calendar"
            style="@style/NavItem"
            android:contentDescription="@string/nav_calendar">

            <TextView
                style="@style/Text.NavIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_calendar_icon" />

            <TextView
                style="@style/Text.NavLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_calendar" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_add"
            style="@style/NavItem"
            android:contentDescription="@string/nav_add">

            <TextView
                style="@style/Text.NavIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_add_icon" />

            <TextView
                style="@style/Text.NavLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_add" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_insights"
            style="@style/NavItem"
            android:contentDescription="@string/nav_insights">

            <TextView
                style="@style/Text.NavIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_insights_icon" />

            <TextView
                style="@style/Text.NavLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_insights" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
