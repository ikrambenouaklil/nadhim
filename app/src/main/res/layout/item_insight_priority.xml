<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingBottom="4dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical">
        <TextView android:id="@+id/insightPriorityName" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="@color/card_text_primary" android:textSize="12sp" />
        <TextView android:id="@+id/insightPriorityValue" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="@color/card_text_secondary" android:textSize="11sp" />
    </LinearLayout>
    <ProgressBar android:id="@+id/insightPriorityProgress" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="6dp"
        android:max="100" android:progress="0" />
</LinearLayout>
